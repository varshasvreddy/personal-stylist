# Copy these into your shell or hosting dashboard. Nothing here is read from a file automatically.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
# CSRF_TRUSTED_ORIGINS=https://your-site.example
# DJANGO_DB_PATH=/data/db.sqlite3
# DJANGO_MEDIA_ROOT=/data/media

# Turns on Claude styling, photo reading and photo reviews. Without it the built-in rules are used.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
